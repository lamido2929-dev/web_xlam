<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chan Bố Mày ĐI</title>
    <style>
        body {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f4f4f9;
        }
        h1 {
            color: #333;
            margin-bottom: 20px;
        }
        img {
            width: 200px; /* Chỉnh kích thước ảnh nhỏ vừa phải tại đây (bạn có thể đổi thành 150px hoặc 250px tùy ý) */
            height: auto;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body>

    <h1>Chan Bố mày đi</h1>
    <img src="https://photo.znews.vn/w860/Uploaded/IZB_M2/2013_09_21/Thieu_nu_nghiem_tuc.jpg" alt="Linnnnnn Kidddddđ">

</body>
</html>
